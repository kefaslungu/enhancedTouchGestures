#. Translators: dialog title shown when trying to install the add-on on unsupported systems.
#: addon\installTasks.py:24
msgid "Enhanced Touch Gestures install warning"
msgstr "Hişyariya sazkirina Jestên Destikê yên Pêşkeftî"

#. No touch hardware whatsoever
#. Translators: dialog text shown when trying to install the add-on on unsupported systems.
#: addon\installTasks.py:29
msgid "This device does not support touch interaction. A touch capable device is required to use add-on features."
msgstr "Ev cîhaz piştgiriya têkiliya destavêtinê nake. Ji bo bikaranîna taybetmendiyên pêvek cîhazek ku xwedî kapasîteya destavêtinê ye hewce ye."

#. Portable NVDA running on a touch capable hardware
#. Translators: dialog text shown when trying to install the add-on on unsupported systems.
#: addon\installTasks.py:33
msgid "You are using a portable copy of NVDA and the device supports touch interaction. NVDA must be installed to use add-on features."
msgstr "Hûn kopiyek veguhêzbar a NVDA-yê bikar tînin û cîhaz bi destdana destan piştgirî dike. Ji bo bikaranîna taybetmendiyên pêvek divê NVDA were saz kirin."

#. Translators: The name of a touch mode.
#: addon\globalPlugins\enhancedTouchGestures.py:43
msgid "synth settings mode"
msgstr "moda mîhengên synthê"

#. Translators: The gestures category for this add-on in input gestures dialog (2013.3 or later).
#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: addon\globalPlugins\enhancedTouchGestures.py:55 buildVars.py:21
msgid "Enhanced Touch Gestures"
msgstr "Jestên Destikê yên Pêşkeftî"

#. Translators: input help message for Enhanced touch Gestures command.
#: addon\globalPlugins\enhancedTouchGestures.py:154
msgid "Emulates pressing tab on the system keyboard"
msgstr "Tepandina Tabê li ser klavyeya pergalê teqlîd dike"

#. Translators: input help message for Enhanced touch Gestures command.
#: addon\globalPlugins\enhancedTouchGestures.py:162
msgid "Emulates pressing shift+tab on the system keyboard"
msgstr "Tepandina shift+tab li ser klavyeya pergalê teqlîd dike"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:24
msgid "This add-on provides additional touchscreen gestures for NVDA, including focus reporting and synth settings ring gestures."
msgstr "Ev pêvek ji bo NVDA-yê jestên ekrana desta yên zêdetir peyda dike, di nav de raporkirina fokusê û jestên zengilê yên mîhengên synthê."

#. Brief changelog for this version
#. Translators: what's new content for the add-on version to be shown in the add-on store
#: buildVars.py:29
msgid ""
"* Removed add-on changelog from add-on help (readme) file.\n"
"* The \"default (all elements)\" mode in touch browse mode is now called "
"\"default\" mode to match NVDA 2026.2 messaging.\n"
"* If running NVDA 2026.2, NVDA will no longer appear to do nothing or play "
"error tones when performing browse touch mode commands in web browsers while "
"navigator object is located somewhere other than the document content."
msgstr ""
"* Removed add-on changelog from add-on help (readme) file.\n"
"* The \"default (all elements)\" mode in touch browse mode is now called "
"\"default\" mode to match NVDA 2026.2 messaging.\n"
"* If running NVDA 2026.2, NVDA will no longer appear to do nothing or play "
"error tones when performing browse touch mode commands in web browsers while "
"navigator object is located somewhere other than the document content."
